# Root .env — read by `docker compose` for variable substitution in
# docker-compose.yml. Copy to `.env` (gitignored) and fill in what you need.
# Everything here has a working default in docker-compose.yml, so `.env` is optional.

# Database for the whole stack. Leave unset to use the bundled `mongo` container.
# Set it to a MongoDB Atlas SRV URI to write to a remote cluster instead.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/tor_website?retryWrites=true&w=majority

# Signing secret for the backend's session JWTs.
# JWT_SECRET=change-me
