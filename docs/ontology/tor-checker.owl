  <rdf:Description rdf:about="https://github.com/SW-Process/TOR_website/ontology#Stage_LifecycleRefresh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://github.com/SW-Process/TOR_website/ontology#PipelineStage"/>
    <rdfs:label xml:lang="en">Lifecycle refresh</rdfs:label>
    <rdfs:comment xml:lang="en">Re-checks unfinished TORs' procurement stage from national e-GP first, then BMA e-GP; no Gemini call for the stage.</rdfs:comment>
    <tor:runsOn rdf:resource="https://github.com/SW-Process/TOR_website/ontology#LifecycleJob"/>
    <tor:runsOn rdf:resource="https://github.com/SW-Process/TOR_website/ontology#EnrichmentBatchJob"/>
    <tor:readsFrom rdf:resource="https://github.com/SW-Process/TOR_website/ontology#NationalEGP"/>
    <tor:readsFrom rdf:resource="https://github.com/SW-Process/TOR_website/ontology#BmaEGP"/>
    <tor:implementedIn rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Mod_Lifecycle"/>
    <tor:implementedIn rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Mod_ProcurementStage"/>
    <tor:usesData rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Collection_tors"/>
