  <rdf:Description rdf:about="https://github.com/SW-Process/TOR_website/ontology#Stage_Enrichment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://github.com/SW-Process/TOR_website/ontology#PipelineStage"/>
    <rdfs:label xml:lang="en">AI enrichment</rdfs:label>
    <rdfs:comment xml:lang="en">Claims queued jobs under a lease; one Gemini multimodal call per TOR classifies it, writes the AI summary, the category and fairness flags.</rdfs:comment>
    <tor:runsOn rdf:resource="https://github.com/SW-Process/TOR_website/ontology#EnrichmentBatchJob"/>
    <tor:callsService rdf:resource="https://github.com/SW-Process/TOR_website/ontology#GeminiVertexAI"/>
    <tor:implementedIn rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Mod_Enrichment"/>
    <tor:implementedIn rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Mod_Taxonomy"/>
    <tor:usesData rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Collection_tors"/>
    <tor:usesData rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Collection_enrichmentjobs"/>
    <tor:usesData rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Collection_ingestionruns"/>
    <tor:usesData rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Collection_systemlogs"/>
    <tor:precedes rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Stage_LifecycleRefresh"/>
    <tor:precedes rdf:resource="https://github.com/SW-Process/TOR_website/ontology#Stage_MatchNotification"/>
  </rdf:Description>
