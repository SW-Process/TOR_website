PORT=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# Auth
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
# Express "trust proxy": blank = trust none (local dev). Behind a load balancer set the
# number of proxy hops (e.g. 1) so signed-in devices show the user's real IP, not the proxy's.
# Avoid "true" — it trusts any X-Forwarded-For a client sends.
TRUST_PROXY=

# Google OAuth 2.0 (FR-21) — from Google Cloud Console > Credentials.
# Leave blank to disable the Google sign-in routes (they return 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Blob storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# GCS_BUCKET=

# e-GP ingestion scraper
EGP_API_BASE=https://egp2.bangkok.go.th/appapi/api
EGP_FILE_BASE=https://egp2.bangkok.go.th/api/file
EGP_LISTING_BASE=https://egp2.bangkok.go.th/project-detail
EGP_USER_AGENT=BkkTorAggregator/0.1 (Kasetsart University project; <contact-email>)
EGP_REQUEST_DELAY_MS=400
EGP_MAX_RETRIES=4
EGP_TIMEOUT_MS=120000
EGP_MAX_FILE_BYTES=52428800
INGEST_DEFAULT_SEARCH=ซอฟต์แวร์
INGEST_DEFAULT_MAX_PROJECTS=50
# Agency allowlist — exact masterOrgGroupName values, comma-separated; empty = allow all
INGEST_AGENCIES=สำนักดิจิทัลกรุงเทพมหานคร,สำนักการแพทย์,สำนักอนามัย,สำนักสิ่งแวดล้อม,สำนักการจราจรและขนส่ง
# Discovery's e-GP search window: sets fromDate/toDate to [now - N days, now]
INGEST_LOOKBACK_DAYS=7

# AI enrichment (Cloud Run Job: npm run job:enrichment)
# EXTRACTOR: unset or "gemini" uses the Vertex GeminiExtractor; any other value fails fast.
EXTRACTOR=gemini
# Vertex AI project/region for the GeminiExtractor. Leave GOOGLE_CLOUD_PROJECT blank
# to fall back to the Cloud Run metadata project; keep VERTEX_MODEL pinned.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.5-flash
# Hard cap on Gemini calls per enrichment batch (cost guard)
MAX_AI_CALLS_PER_RUN=50
# Max TORs the daily lifecycle refresh re-checks against e-GP per run (e-GP politeness cap)
MAX_LIFECYCLE_REFRESH_PER_RUN=100
# Max invitation PDFs the lifecycle refresh may send to Gemini per run (bid-deadline reading).
MAX_DEADLINE_EXTRACTIONS_PER_RUN=20
# National e-GP (process5.gprocurement.go.th) is the primary source for stage and bid deadline in the
# lifecycle refresh; the BMA portal (egp2) is the fallback. false/0/off/no turns it off.
GPROC_ENABLED=true
GPROC_BASE_URL=https://process5.gprocurement.go.th
GPROC_DELAY_MS=500
GPROC_TIMEOUT_MS=30000
GPROC_MAX_RETRIES=3
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa.json   # local dev only; on Cloud Run auth is ADC

# Outbound email (admin alerts, later password reset).
# "log" prints messages instead of sending them (local development).
# "sendgrid" sends through SendGrid and needs SENDGRID_API_KEY and EMAIL_FROM.
EMAIL_DRIVER=log
# SendGrid API key (Settings > API Keys, "Mail Send" permission). Secret: keep it out of git.
SENDGRID_API_KEY=
# Verified sender address in SendGrid (Single Sender or an authenticated domain).
EMAIL_FROM=

# Comma-separated addresses that get an email when a pipeline run fails or stalls (FR-39).
# Blank = no email; the in-app admin notification is created either way.
ADMIN_ALERT_EMAILS=
