# Mongoose connection used by the Next.js route handlers (src/lib/mongodb.ts
# throws on startup if this is unset).
MONGODB_URI=

# Base URL of the Express backend, used by the browser (auth, etc.).
# Inlined at build time for production images; read at runtime in dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL the *server* (Server Components, e.g. the homepage and TOR detail
# page) uses to reach the backend. Only needed when the server and browser
# don't share a host — e.g. in Docker, where it's the backend's service DNS
# name (see docker-compose.yml). Leave unset for local (non-Docker) dev,
# where NEXT_PUBLIC_API_BASE_URL already resolves from both sides.
INTERNAL_API_BASE_URL=
